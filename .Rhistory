library(Hmisc)
library(FSA)
library(readr)
library(NbClust)
library(factoextra)
library(FactoMineR)
library(ggplot2)
library(RColorBrewer)
library(cluster)
library(stats)
library(wesanderson)
library(ggforce)
library(corrplot)
library(missMDA)
library(tidyverse)
library(ggcorrplot)
library(ggstatsplot)
options(stringsAsFactors = FALSE)
# -------------------- Leitura dos dados -------------------- #
famd <- read_csv2("Folha_Fruto.CSV", locale = locale(encoding = "UTF-8")) |> type_convert()
famd <- famd[1:26, 2:17]
famd[] <- lapply(famd, function(x) {
if (is.character(x)) {
as.factor(x)
} else if (is.numeric(x) && length(unique(x)) <= 3) {
as.factor(x)
} else {
x
}
})
# -------------------- FAMD com imputação -------------------- #
estim_ncp <- estim_ncpFAMD(famd, ncp.max = 3)
famd_imputado <- imputeFAMD(famd, ncp = estim_ncp$ncp)$completeObs
res.famd <- FAMD(famd_imputado, graph = FALSE)
summary(res.famd)
fviz_famd_ind(res.famd, repel = TRUE)
fviz_famd_var(res.famd, col.var = "orange", repel = TRUE)
# Calcula a matriz de distância entre indivíduos com base nas coordenadas da FAMD
dist_famd <- dist(res.famd$ind$coord)
sil <- silhouette(res.km$cluster, dist_famd)
# Plota o gráfico de silhueta
fviz_silhouette(sil, palette = "jco", ggtheme = theme_minimal())
mean(sil[, "sil_width"])  # Valor médio de silhueta (quanto mais próximo de 1, melhor)
fviz_nbclust(res.famd$ind$coord, kmeans, method = "silhouette") +
labs(subtitle = "Número ótimo de clusters (método da silhueta)")
# -------------------- K-means clustering -------------------- #
res.km <- kmeans(res.famd$ind$coord, centers = 3, nstart = 25)
famd_imputado$cluster <- as.factor(res.km$cluster)
summary(res.km)
# -------------------- FAMD com clusters -------------------- #
custom_colors <- c("1" = "#E41A1C", "2" = "#354823", "3" = "#A2A475",
"4" = "#FAD510", "5" = "#F781BF", "6" = "#377EB8", "7" = "#01665E")
custom_shapes <- c(6, 16, 18, 17, 15, 23, 1, 4)
fviz_screeplot(res.famd, addlabels = TRUE, ylim = c(0, 35))
fviz_contrib(res.famd, choice = "var", axes = 1)
fviz_screeplot(res.famd, addlabels = TRUE, ylim = c(0, 35))
fviz_contrib(res.famd, choice = "var", axes = 1)
fviz_contrib(res.famd, choice = "var", axes = 2)
fviz_contrib(res.famd, choice = "var", axes = 3)
fviz_contrib(res.famd, choice = "var", axes = 2)
fviz_contrib(res.famd, choice = "var", axes = 1)
# -------------------- HCPC -------------------- #
res.hcpc <- HCPC(res.famd, graph = FALSE)
plot_famd_clusters <- function(res.famd, res.hcpc, eixo_x = 1, eixo_y = 2) {
ind_df <- as.data.frame(res.famd$ind$coord)
ind_df$cluster <- as.factor(res.hcpc$data.clust$clust)
ind_df$UTO <- rownames(res.famd$ind$coord)
colnames(ind_df)[eixo_x] <- "EixoX"
colnames(ind_df)[eixo_y] <- "EixoY"
hulls_list <- lapply(split(ind_df, ind_df$cluster), function(df) df[chull(df$EixoX, df$EixoY), ])
hulls <- do.call(rbind, hulls_list)
hulls$cluster <- rep(levels(ind_df$cluster), sapply(hulls_list, nrow))
var_x <- paste0("Dim ", eixo_x, " (", round(res.famd$eig[eixo_x, 2], 1), "%)")
var_y <- paste0("Dim ", eixo_y, " (", round(res.famd$eig[eixo_y, 2], 1), "%)")
ggplot(ind_df, aes(x = EixoX, y = EixoY, color = cluster, shape = cluster)) +
geom_polygon(data = hulls, aes(fill = cluster, group = cluster), alpha = 0.2, color = NA) +
geom_point(size = 5) +
geom_text(aes(label = UTO), size = 3, vjust = -0.8, color = "black") +
geom_vline(xintercept = 0, linetype = "dashed", color = "grey40") +
geom_hline(yintercept = 0, linetype = "dashed", color = "grey40") +
scale_color_manual(values = custom_colors) +
scale_fill_manual(values = custom_colors) +
scale_shape_manual(values = custom_shapes[1:length(unique(ind_df$cluster))]) +
theme_classic() +
labs(title = paste("FAMD - Dim", eixo_x, "&", eixo_y),
x = var_x, y = var_y, color = "Cluster", fill = "Cluster", shape = "Cluster")
}
plot_famd_clusters(res.famd, res.hcpc, eixo_x = 1, eixo_y = 2)
plot_famd_clusters(res.famd, res.hcpc, eixo_x = 1, eixo_y = 3)
plot_famd_clusters(res.famd, res.hcpc, eixo_x = 2, eixo_y = 3)
plot_famd_clusters(res.famd, res.hcpc, eixo_x = 1, eixo_y = 2)
plot_famd_clusters(res.famd, res.hcpc, eixo_x = 1, eixo_y = 3)
plot_famd_clusters(res.famd, res.hcpc, eixo_x = 2, eixo_y = 3)
