df_all <- cbind(df_cor, tipo = df_tipo$value, pval = df_p$value)
colnames(df_all) <- c("Var1", "Var2", "cor", "tipo", "pval")
df_all$Var1 <- as.character(df_all$Var1)
df_all$Var2 <- as.character(df_all$Var2)
# Filtrar para manter apenas a metade inferior
df_all_filtrado <- df_all[df_all$Var1 >= df_all$Var2, ]
# Plot
ggplot(df_all_filtrado, aes(x = Var1, y = Var2, fill = cor)) +
geom_tile(color = "white") +
scale_fill_gradient2(low = "#E46726", mid = "white", high = "#6D9EC1", midpoint = 0,
name = "Correlation") +
geom_text(aes(label = round(cor, 2)), size = 5) +
geom_text(aes(label = tipo), nudge_y = -0.25, size = 3, fontface = "italic", color = "black") +
theme_minimal(base_family = "serif") +  # <-- aqui define a fonte
labs(title = "Correlation Matrix with Type (P = Pearson, S = Spearman)",
x = "", y = "") +
theme(axis.text.x = element_text(angle = 30, hjust = 1, size = 10))
# Se ainda tiver "Sp." com ponto no nome, renomeie para evitar problemas
names(famd)[names(famd) == "Sp."] <- "Taxa"
variaveis_morfologicas <- c(
"Ind.","SideLf_wid_min","TermLf_shape","Indum_abax","Indum_adax", "Articles", "Apex_Wing"
)
for (var in variaveis_morfologicas) {
print(
ggbarstats(
data = famd,
x = Taxa,                 # agora usando a coluna "Taxa"
y = !!sym(var),           # avaliação dinâmica da variável morfológica
title = paste("Association between", var, "and Taxa"),
results.subtitle = TRUE
)
)
}
# -------------------- FAMD com imputação -------------------- #
estim_ncp <- estim_ncpFAMD(famd, ncp.max = 3)
