library(Hmisc)
library(FSA)
library(readr)
library(ggplot2)
library(stats)
library(corrplot)
library(tidyverse)
library(ggstatsplot)
library(reshape2)
options(stringsAsFactors = FALSE)
# ---------------------- Visual Normality Check ---------------------- #
# Criando e armazenando gráficos de normalidade na lista 'results'
results$normality_plots <- list()
ading and Processing -------------------- #
# -------------------- Data Reading and Processing -------------------- #
###---Replace with leaf_fruit.CSV for leaf and fruit analysis---###
famd <- read_csv2("flower.CSV", locale = locale(encoding = "UTF-8")) |> type_convert()
famd[] <- lapply(famd, function(x) {
if (is.character(x)) {
as.factor(x)
} else if (is.numeric(x) && length(unique(x)) <= 3) {
as.factor(x)
} else {
x
}
})
# ---------------------- Quantitative Data Tests ---------------------- #
famd_numeric <- famd[ , sapply(famd, is.numeric)]
# Normality test (Shapiro-Wilk)
shapiro_results <- apply(famd_numeric, 2, function(x) {
x <- na.omit(x)
if (length(x) < 3) return(NA)
shapiro.test(x)$p.value
})
# Separate variables
normal_vars <- names(shapiro_results[shapiro_results > 0.05])
non_normal_vars <- names(shapiro_results[shapiro_results <= 0.05])
results <- list()
# ANOVA loop for normal variables
for (var in normal_vars) {
formula <- as.formula(paste0("`", var, "` ~ `Sp.`"))
model <- aov(formula, data = famd)
p <- summary(model)[[1]][["Pr(>F)"]][1]
posthoc <- TukeyHSD(model)
results[[var]] <- list(
type = "ANOVA",
p_value = p,
posthoc = posthoc
)
}
# ---------------------- Visual Normality Check ---------------------- #
# Criando e armazenando gráficos de normalidade na lista 'results'
results$normality_plots <- list()
for (var in names(famd_numeric)) {
data_var <- na.omit(famd_numeric[[var]])
# Pula se não houver dados suficientes
if (length(data_var) < 3) next
# Parâmetros para a curva normal teórica
media <- mean(data_var)
desvio <- sd(data_var)
# 1. Histograma + Curva Normal Teórica + Curva de Densidade Real
p_hist <- ggplot(data.frame(x = data_var), aes(x = x)) +
geom_histogram(aes(y = after_stat(density)), bins = 30, fill = "skyblue", color = "black", alpha = 0.6) +
# Curva normal teórica (vermelha tracejada)
stat_function(fun = dnorm, args = list(mean = media, sd = desvio),
color = "red", linewidth = 1.2, linetype = "dashed") +
# Curva de densidade real (azul contínua)
geom_density(color = "darkblue", linewidth = 1) +
labs(
title = paste("Distribuição de", var),
subtitle = paste(
"Shapiro-Wilk p-valor:", round(shapiro_results[var], 4),
ifelse(shapiro_results[var] > 0.05, "(Normal)", "(Não-Normal)")
),
x = var,
y = "Densidade"
) +
theme_minimal()
# 2. Q-Q Plot
p_qq <- ggplot(data.frame(x = data_var), aes(sample = x)) +
stat_qq(color = "darkblue", alpha = 0.6) +
stat_qq_line(color = "red", linewidth = 1) +
labs(
title = paste("Q-Q Plot de", var),
x = "Quantis Teóricos (Distribuição Normal)",
y = paste("Quantis da Amostra (", var, ")")
) +
theme_minimal()
# Salva os gráficos na lista 'results'
results$normality_plots[[var]] <- list(histograma = p_hist, qq_plot = p_qq)
# Opcional: Imprime os gráficos na tela imediatamente (descomente para usar)
# print(p_hist)
# print(p_qq)
}
print(results$normality_plots[[1]]$histograma)
print(results$normality_plots[[2]]$histograma)
print(results$normality_plots[[3]]$histograma)
print(results$normality_plots[[4]]$histograma)
print(results$normality_plots[[5]]$histograma)
print(results$normality_plots[[6]]$histograma)
print(results$normality_plots[[7]]$histograma)
print(results$normality_plots[[8]]$histograma)
print(results$normality_plots[[10]]$histograma)
print(results$normality_plots[[11]]$histograma)
print(results$normality_plots[[12]]$histograma)
print(results$normality_plots[[13]]$histograma)
